#include <stdio.h>

int main()
{
    int a, b;
    
    printf ("Digite dois números:\n");
    scanf ("%d%d", &a, &b);
    
    if (a > b){
        printf ("%d é maior que %d", a, b);
    }
    
    else if (a==b){
        printf ("%d é igual %d",a, b);
    }
    
    else {
        printf ("%d é maior que %d", b, a);
    }

    return 0;
}
